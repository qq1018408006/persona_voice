CONFIG_IDF_TARGET="esp32s3"

# SparkBot: ESP32-S3-WROOM-1-N16R8
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=256
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# SRTP uses AES-CTR on small RTP packets; software AES is cheap and avoids
# the AES-DMA path's per-packet internal-DMA allocations, which intermittently
# failed under memory pressure ("esp-aes: Failed to allocate memory") and
# silently dropped RTP packets.  No TLS endpoints are used on this device.
CONFIG_MBEDTLS_HARDWARE_AES=n
# Internal RAM is the tightest resource (LVGL + ESP-SR + LiveKit all share
# it).  Eight static RX buffers are plenty for a 16 kHz voice uplink and
# keep the WiFi DMA pool small enough to initialize reliably.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
# Voice traffic is a handful of small UDP frames; halve the static TX pool
# and the management short-buffer pool to keep internal DMA available for
# the I2S renderer and the SPI LCD copy buffer.
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=16
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=8
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y

# LiveKit/WebRTC requirements
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_ESP_WS_CLIENT_ENABLE_DYNAMIC_BUFFER=y
CONFIG_ESP_WS_CLIENT_SEPARATE_TX_LOCK=y
# The LiveKit server/proxy can occasionally return an Upgrade response larger
# than ESP-IDF's 1 KiB transport default.  The transport owns this buffer
# separately from the WebSocket payload buffer; 8 KiB prevents a needless
# reconnect during signaling setup.
CONFIG_WS_BUFFER_SIZE=8192
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_SSL_DTLS_SRTP=y
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_LWIP_SNTP_MAX_SERVERS=2

# 16 MB dual-OTA layout plus the ESP-SR model partition.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# ESP-SR: local "Jarvis" WakeNet-only recognition (MultiNet disabled).
CONFIG_MODEL_IN_FLASH=y
CONFIG_SR_WN_WN9_JARVIS_TTS=y
CONFIG_SR_MN_CN_NONE=y
CONFIG_SR_MN_EN_NONE=y

# Useful failure diagnostics for a permanently powered terminal.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_PANIC=y
