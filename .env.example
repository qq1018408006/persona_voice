# =============================================================
# Persona Voice 统一环境变量
# =============================================================
# 复制本文件为仓库根目录 .env 并填写：
#   cp .env.example .env
# 所有电脑端服务（Python Agent、Token 服务）启动时都会自动读取根目录 .env。
# 注意：.env 含密钥，已被 gitignore，永不提交。
#
# 填写顺序建议：先填【必改】区，再看【可选】区，最后【默认】区基本不用动。

# -------------------------------------------------------------
# 一、必改（不填服务起不来 / 设备连不上）
# -------------------------------------------------------------

# [必改] 设备（固件/手机）可访问的局域网地址，不能是 localhost/127.0.0.1。
#        填运行 `docker run --rm --network host livekit/livekit-server:v1.13.4
#        --dev --bind 0.0.0.0` 那台电脑的局域网 IP。
LIVEKIT_PUBLIC_URL=ws://<你的电脑局域网IP>:7880

# [必填] Gemini Live API Key（到 Google AI Studio 申请）
GOOGLE_API_KEY=<google_ai_studio_api>

# [必改] 固件房间名（自己取，别用示例值；和手机房间保持不同）
LIVEKIT_ROOM=<你的固件房间名>

# [必改] 手机 App 房间名（自己取，别用示例值；与固件房间分开）
LIVEKIT_ANDROID_ROOM=<你的手机房间名>

# [必改] 设备密钥：生成一段长随机字符串。
#        需与固件 menuconfig 的 SPARKBOT_TOKEN_API_KEY、
#        手机 App TokenExt.kt 的 localDeviceKey 保持一致。
TOKEN_SERVICE_KEY=<长随机密钥>

# -------------------------------------------------------------
# 二、可选（用对应的后端/功能才填）
# -------------------------------------------------------------

# [可选] Hermes 后端密钥（不装 Hermes 可留空，只是“让小 H 做”不可用）
HERMES_API_KEY=<hermes_api>

# [可选] 个人日记目录（留空则 Agent 不读取任何个人文件）
HERMES_DIARY_DIR=

# [可选] Codex 工作目录（不装 Codex 可留空，只是“让小 C 做”不可用）
CODEX_WORKSPACE=/path/to/your/codex/workspace

# -------------------------------------------------------------
# 三、推荐确认（默认值通常可用，但值得看一眼）
# -------------------------------------------------------------

# [注意] Token 服务端口：手机 App 硬编码 8082，一般保持 8082 不要改。
TOKEN_SERVER_PORT=8082

# [注意] 分发的 Agent 名称：与 agent_hermes.py 注册名一致；
#        改了 Agent 名称才需要动这里。
LIVEKIT_AGENT_NAME=memo-agent

# -------------------------------------------------------------
# 四、默认即可（一般不用动；换 LiveKit Cloud 时才改）
# -------------------------------------------------------------

# Agent 与 Token 服务在本机访问 LiveKit 的地址
LIVEKIT_URL=ws://127.0.0.1:7880

# 自建 LiveKit dev 模式默认 devkey/secret；LiveKit Cloud 请用项目提供的值
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Token 服务监听地址（0.0.0.0 = 局域网内所有设备可访问）
TOKEN_SERVER_HOST=0.0.0.0

# Hermes 后端地址与模型（本地默认）
HERMES_BASE_URL=http://127.0.0.1:8642
HERMES_MODEL=hermes-agent
# Hermes 轮询间隔（秒）与任务超时（秒）（可选）
HERMES_POLL_INTERVAL_SECONDS=0.5
HERMES_RUN_TIMEOUT_SECONDS=300

# Gemini Live 音色（可选）
GEMINI_LIVE_VOICE=Puck
# 唤醒时是否让 Agent 自动播报一句问候（可选：false/true）
ENABLE_GREETING=false

# Codex CLI 命令与模型（留空用 Codex 默认模型）
CODEX_COMMAND=codex
CODEX_MODEL=
CODEX_RUN_TIMEOUT_SECONDS=600

# 频道投递（Hermes 的 hermes send 通道）
CHANNEL_SENDER_COMMAND=hermes
HERMES_CHANNEL_TARGET=telegram
CODEX_CHANNEL_TARGET=telegram

# 设备使用的 LiveKit 公网端口；一般由 LIVEKIT_PUBLIC_URL 自动推断，
# 无需设置（如需覆盖，取消注释并填端口号）
# LIVEKIT_PUBLIC_PORT=7880

# -------------------------------------------------------------
# 五、Android App（不读本文件，仅提示）
# -------------------------------------------------------------
# App 的连接参数目前硬编码在
# android/app/src/main/java/io/livekit/android/example/voiceassistant/TokenExt.kt：
#   - localTokenServerUrl  → http://<你的电脑局域网IP>:8082/livekit/token
#   - localDeviceKey       → 与上面的 TOKEN_SERVICE_KEY 一致
#   - localRoomName        → 与上面的 LIVEKIT_ANDROID_ROOM 一致
